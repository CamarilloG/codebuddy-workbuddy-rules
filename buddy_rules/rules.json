{
  "schema_version": 1,
  "ruleset_version": "0.1.0",
  "verification": "synthetic-regression-only; no live platform compatibility claim",
  "text_rules": [
    {
      "id": "identity.claude-code",
      "category": "client-identity",
      "clients": ["claude-code"],
      "roles": ["system", "developer", "assistant"],
      "pattern": "(?m)^[ \\t]*You are Claude Code, Anthropic's official CLI for Claude(?:, running within the Claude Agent SDK)?\\.(?=\\s|$)[ \\t]*(?:\\r?\\n)?",
      "replacement": "",
      "default_enabled": false
    },
    {
      "id": "identity.claude-feedback",
      "category": "client-identity",
      "clients": ["claude-code"],
      "roles": ["system", "developer", "assistant"],
      "pattern": "(?m)^[ \\t]*-[ \\t]*To give feedback, users should report the issue at https://github\\.com/anthropics/claude-code/issues[ \\t]*(?=\\r?$)(?:\\r?\\n)?",
      "replacement": "",
      "default_enabled": false
    },
    {
      "id": "identity.codex",
      "category": "client-identity",
      "clients": ["codex"],
      "roles": ["system", "developer"],
      "pattern": "(?m)^[ \\t]*Codex CLI is an open source project led by OpenAI\\.(?:[ \\t]*\\r?\\n|[ \\t]+|$)",
      "replacement": "",
      "default_enabled": false
    }
  ],
  "header_policy": {
    "mode": "allowlist",
    "default_forward": ["accept", "content-type"],
    "never_forward": ["authorization", "proxy-authorization", "cookie", "set-cookie", "x-api-key", "api-key", "host", "content-length", "connection", "transfer-encoding", "keep-alive", "te", "trailer", "upgrade"],
    "agent_identity_examples": ["user-agent", "x-ide-name", "x-ide-type", "x-ide-version", "x-agent-intent", "x-agent-purpose", "x-agent-type", "x-claude-code-session-id", "x-opencode-session", "x-opencode-session-id"]
  }
}
